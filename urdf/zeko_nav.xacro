<?xml version="1.0"?>
<!--
  zeko_nav.xacro — Top-level XACRO for ZEKO navigation build.

  Includes:
    - All original model modules (base, wheels, casters, support_frame, pelvis_mount)
    - urdf/lidar.xacro  (lidar_link for AMCL — mounted at body-base junction)
    - urdf/body.xacro   (visual-only upper torso body mesh)

  Build:
    xacro urdf/zeko_nav.xacro > urdf/zeko.urdf
-->
<robot name="zeko" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:include filename="$(find robot_base_simulation)/urdf/materials.xacro"/>
  <xacro:include filename="$(find robot_base_simulation)/urdf/base.xacro"/>
  <xacro:include filename="$(find robot_base_simulation)/urdf/wheels.xacro"/>
  <xacro:include filename="$(find robot_base_simulation)/urdf/casters.xacro"/>
  <xacro:include filename="$(find robot_base_simulation)/urdf/support_frame.xacro"/>
  <xacro:include filename="$(find robot_base_simulation)/urdf/pelvis_mount.xacro"/>

  <!-- LiDAR sensor frame (at body-base junction, z=0.68 m above base_link) -->
  <xacro:include filename="$(find robot_base_simulation)/urdf/lidar.xacro"/>

  <!-- Upper torso body — visual only, no physics -->
  <xacro:include filename="$(find robot_base_simulation)/urdf/body.xacro"/>

  <ros2_control name="zeko_system" type="system">
    <hardware>
      <plugin>mock_components/GenericSystem</plugin>
    </hardware>
    <joint name="left_wheel_joint">
      <command_interface name="velocity">
        <param name="min">-20.0</param>
        <param name="max">20.0</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="right_wheel_joint">
      <command_interface name="velocity">
        <param name="min">-20.0</param>
        <param name="max">20.0</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

</robot>
