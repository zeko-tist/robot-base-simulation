    body_joint: fixed to pelvis_mount_link, placed at its top face.
    pelvis_mount_link origin is at z=0.504 m above base_link.
    pelvis_mount_link height = 0.152 m → top at z=0.656 m above base_link.
    So xyz="0 0 0.152" places body_link at that top face.
  -->
  <joint name="body_joint" type="fixed">
    <parent link="pelvis_mount_link"/>
    <child link="body_link"/>
    <origin rpy="0 0 0" xyz="0 0 0.152"/>
  </joint>
