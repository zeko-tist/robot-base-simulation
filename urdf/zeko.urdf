  <!-- Visual-only body link — no inertia, no collision -->
  <link name="body_link">
    <visual>
      <!--
        Visual origin:
          xyz = (0, 0.28, 0.64)
            0    = no forward/backward offset (OBJ Y-axis is already centred)
            0.28 = centres the body laterally (OBJ X-centre is at 28 cm, not 0)
            0.64 = lifts body so its bottom (OBJ Z=-64 cm) aligns with z=0 of body_link
          rpy = (0, 0, -π/2)
            Applies cad_yaw rotation so OBJ Y (depth/front-back) → ROS X (forward)
      -->
      <origin rpy="0 0 -1.5707963267948966" xyz="0 0.28 0.64"/>
      <geometry>
        <mesh filename="package://robot_base_simulation/meshes/zeko_body.obj" scale="0.01 0.01 0.01"/>
      </geometry>
    </visual>
    <!-- No collision — body is decorative, robot footprint is defined in Nav2 params -->
    <!-- No inertial — fixed joint, mass handled by pelvis_mount_link -->
  </link>
